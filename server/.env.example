# Copy to server/.env and fill in. Never commit the real file.

# Port the server listens on
PORT=8787

# Model provider. Without MODEL_API_KEY the server runs in retrieval-only mode,
# which still answers from the knowledge base and never invents a fee.
MODEL_API_KEY=
MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions
MODEL_NAME=gpt-4o-mini

# Lock this to your Pages origin in production, e.g.
# https://sriabhinandansingh-prog.github.io
ALLOWED_ORIGIN=*

# Requests per IP per 10 minutes
RATE_LIMIT=30

# Optional: also serve the static site from this process
# STATIC_DIR=.
