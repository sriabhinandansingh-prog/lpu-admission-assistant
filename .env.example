# Server
PORT=8787
ALLOWED_ORIGIN=https://sriabhinandansingh-prog.github.io
RATE_LIMIT=30

# Model. Leave MODEL_API_KEY empty and the backend runs in retrieval-only mode,
# answering straight from data/knowledge.json with no key at all.
MODEL_API_KEY=
# Any OpenAI-compatible chat-completions URL (NVIDIA NIM, vLLM, Ollama, Together, OpenAI).
MODEL_ENDPOINT=
# The exact id that endpoint uses for the model.
MODEL_NAME=
# Only set this when the endpoint above really serves that model, because the
# assistant introduces itself with it.
MODEL_DISPLAY_NAME=
